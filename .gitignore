#Exluir entorno virtual y archivos de caché de Python
.venv/
__pycache__/

#Excluir archivos de entorno y configuración
.env

#Excluir archivos exe
*.exe

#Excluir la configuración real (credenciales propias). Se publica solo
#src/config-example.py como plantilla; copiar a src/config.py al instalar.
src/config.py

#Ajustes personales de Claude Code (permisos locales, no compartir)
.claude/settings.local.json

#Excluir evidencias de objetos extranos capturadas en el monitoreo
src/resources/desconocidos/

#Excluir modelos entrenados
src/ml/models/*.pt
src/ml/models/**/*.pt



#archivos temporales de node
node_modules/
package-*
package.*
#Excluir volcados de consola (la evidencia de latencia va en docs/evidencias/*.csv)
*.log
